# FMS_V3 環境變數範本
#
# 用法(★在 infra/ 目錄下):cp .env.example .env  然後把下面的密碼全部改掉。
# ★ .env 絕對不進版控(.gitignore 已擋);只有這份 .env.example 進。
#   教材 repo 是公開的——把真密碼 commit 上去,全世界都看得到。

# ── 埠號 ─────────────────────────────────────────────────────
# 本檔刻意【不用】標準埠 5432 / 9000——多數開發機上已經有別的 PostgreSQL
# 或服務佔著它們,用標準埠會在 `docker compose up -d` 當場撞埠啟動失敗,
# 而錯誤訊息(port is already allocated)不會告訴你該改哪裡。
#
# 埠被占用時怎麼辦:改下面的 *_PORT 即可,【改完 PGPORT 要跟著改】。
# 查誰占用:  ss -ltn | grep 5435       (Linux/WSL)
#            netstat -ano | findstr 5435  (Windows)

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=fms
POSTGRES_USER=fms
# ★改掉!compose 對這項不給預設值,沒設會直接啟動失敗(這是故意的)
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_PORT=5435

# 後端連線用(與上面同一組;compose 內部主機名是 db,從宿主機跑則是 localhost)
PGHOST=localhost
PGPORT=5435
PGDATABASE=fms
PGUSER=fms
PGPASSWORD=change-me-before-first-run

# ── 測試資料庫(SDD §6:測試禁連正式庫) ────────────────────────
# 先手動建一次:docker compose exec db createdb -U fms fms_test
TEST_PGDATABASE=fms_test

# ── JWT(TECH-9) ──────────────────────────────────────────────
# ★改掉!至少 32 bytes。產一組:openssl rand -base64 32
JWT_SECRET=change-me-at-least-32-bytes-long-random-string

# ── MinIO(本次作業用不到,為將來預留) ────────────────────────
MINIO_ROOT_USER=fmsadmin
# ★改掉!MinIO 要求至少 8 碼
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_API_PORT=9006
MINIO_CONSOLE_PORT=9007
